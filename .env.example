BIND_ADDR=0.0.0.0:8080
# Hecate API base URL reachable from the propylaea container (not the local Caddy :18443 listener).
UPSTREAM_HECATE_URL=https://hecate.example.com
API_KEY_PEPPER=change-me-same-as-hecate
PROXY_ENROLLMENT_TOKEN=
# Optional override. Prefer mounting host /etc/hostname as /etc/host_hostname.
PROPYLAEA_HOSTNAME=
PROXY_KEY_PATH=/var/lib/hecate-propylaea/proxy.key
PROXY_ID_PATH=/var/lib/hecate-propylaea/proxy_id
SYNC_INTERVAL_SECS=30
HEARTBEAT_INTERVAL_SECS=60
RUST_LOG=info
INSECURE_SKIP_TLS_VERIFY=false
